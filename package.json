{
    "name": "xlsx-context",
    "version": "1.4.0",
    "description": "Convert .xlsx workbooks into structured context and Markdown for AI applications.",
    "license": "Apache-2.0",
    "keywords": [
        "xlsx",
        "excel",
        "spreadsheet",
        "markdown",
        "llm",
        "ai",
        "rag",
        "context",
        "chunking",
        "converter",
        "cli"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bzetsu92/xlsx-context.git"
    },
    "homepage": "https://xlsx-context.vercel.app",
    "bugs": {
        "url": "https://github.com/bzetsu92/xlsx-context/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types/public/index.d.ts",
            "node": "./dist/lib/node.js",
            "default": "./dist/lib/index.js"
        },
        "./worker": {
            "types": "./dist/types/public/worker.d.ts",
            "default": "./dist/lib/worker.js"
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/types/public/index.d.ts",
    "bin": {
        "xlsx-context": "bin/xlsx-context.mjs"
    },
    "files": [
        "bin",
        "dist/lib",
        "dist/types",
        "skills",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "pretest": "npm run build:lib",
        "test": "vitest run --project unit && vitest run --project workbooks && vitest run --project cli",
        "test:unit": "vitest run --project unit",
        "test:workbooks": "vitest run --project workbooks",
        "test:cli": "npm run build:lib && vitest run --project cli",
        "test:perf": "vitest run --project performance",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"bin/**/*.mjs\" \"tests/**/*.js\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"bin/**/*.mjs\" \"tests/**/*.js\"",
        "build:lib": "npm run clean && node scripts/build-library.mjs",
        "build": "npm test",
        "cli": "node bin/xlsx-context.mjs",
        "bench:baseline": "node scripts/bench-xlsx-context-baseline.mjs",
        "clean": "rm -rf dist",
        "typecheck:consumer": "tsc -p tests/types/tsconfig.json",
        "prepack": "npm run build:lib",
        "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run typecheck:consumer"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.9.12"
    },
    "peerDependencies": {
        "iconv-lite": ">=0.6.3",
        "js-tiktoken": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "iconv-lite": {
            "optional": true
        },
        "js-tiktoken": {
            "optional": true
        }
    },
    "devDependencies": {
        "esbuild": "^0.28.1",
        "iconv-lite": "^0.6.3",
        "js-tiktoken": "^1.0.21",
        "jsdom": "^26.0.0",
        "prettier": "^3.9.9",
        "tinybench": "^6.2.1",
        "typescript": "^5.7.3",
        "vitest": "^3.0.0"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    }
}
